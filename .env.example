# Application
APP_NAME=Workless
URL=http://localhost:3000
PORT=3000
LOCALE = th
NODE_ENV=development
VITE_DEV_SERVER_URL=http://localhost:5173

# Database (PostgreSQL)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=
DB_NAME=workless
DB_SYNC=false

# Redis (optional)
REDIS_ENABLED=true
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT
# Required: set a secure random value; this must not be empty.
JWT_SECRET=your-secure-random-value-here
JWT_EXPIRES_IN=1h

# Mail
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS="info@gmail.com"
MAIL_FROM_NAME="${APP_NAME}"
