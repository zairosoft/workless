# This file is a template only. Copy it to .env.production on the server, set
# real values, and keep that file outside source control.

# Public application address. DNS for CADDY_DOMAIN must point to this server.
APP_NAME=Workless
URL=https://app.example.com
CADDY_DOMAIN=app.example.com
CADDY_EMAIL=ops@example.com
HTTP_PORT=80
HTTPS_PORT=443
LOCALE=en

# Leave empty when the browser uses the same public URL as Workless. For a
# separate frontend, use one or more comma-separated exact origins instead.
# CORS_ORIGIN=https://frontend.example.com,https://admin.example.com

# Optional image override for a registry-based deployment.
# APP_IMAGE=registry.example.com/workless:2026.09.10

# PostgreSQL
DB_USERNAME=workless
DB_PASSWORD=replace-with-a-long-random-database-password
DB_NAME=workless

# Redis is mandatory in the production Compose stack.
REDIS_ENABLED=true
REDIS_PASSWORD=replace-with-a-long-random-redis-password
REDIS_DB=0

# Generate with: openssl rand -hex 32
JWT_SECRET=replace-with-a-64-character-random-secret
JWT_EXPIRES_IN=1h

# Optional SMTP settings
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=Workless
